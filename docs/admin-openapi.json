      "get": {
        "tags": [
          "Admin"
        ],
        "summary": "Operational dashboard summary",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Missing/invalid bearer token"
          },
          "403": {
            "description": "Authenticated but not an admin"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
