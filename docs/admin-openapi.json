{
  "openapi": "3.0.0",
  "info": {
    "title": "ProdBnb Admin API",
    "version": "1.0.0",
    "description": "The /v1/admin/* surface only (Phase 11). Every endpoint requires a Supabase access token for a user holding the 'admin' role. Base path is mounted at /v1/admin on the ProdBnb backend."
  },
  "servers": [
    {
      "url": "/v1/admin"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase access token"
      }
    },
    "schemas": {},
    "parameters": {}
  },
