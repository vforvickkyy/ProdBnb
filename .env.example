# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# For local development, start the local Supabase stack (`supabase start`) and
# run `supabase status` to print the local URL and keys. For the hosted
# "ProdBnb" project, get these from the Supabase dashboard: Project Settings > API.

# --- Server ---

# Port the Express server listens on.
PORT=4000

# development | test | production
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the future Web
# client, local dev tools, etc). Leave empty to allow no cross-origin requests.
CORS_ORIGINS=http://localhost:3000

# --- Supabase ---
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to also ship inside client apps
# (iOS/Android/Web) — they only allow what Row Level Security permits.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. SERVER-ONLY. Never send it
# to a client, never log it, never commit it.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-service-role-key

# --- Cloudflare R2 ---
# Actual media (photo/video) storage. Postgres only ever stores metadata/keys,
# never binaries. R2_ACCOUNT_ID/BUCKET_NAME/PUBLIC_BASE_URL are not secret, but
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY are SERVER-ONLY — they can mint signed
# URLs for the whole bucket. Never send them to a client, never log them.

R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET_NAME=replace-with-your-bucket-name
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
# The bucket's public base URL (its r2.dev URL, or a custom domain you've
# connected in the Cloudflare dashboard) — object keys are appended to this.
R2_PUBLIC_BASE_URL=https://replace-with-your-public-bucket-domain

# How long a presigned upload URL stays valid, in seconds.
R2_UPLOAD_URL_EXPIRY_SECONDS=900

# --- Media limits ---
MEDIA_MAX_PHOTO_SIZE_MB=20
MEDIA_MAX_VIDEO_SIZE_MB=500
