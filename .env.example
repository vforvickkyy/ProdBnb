# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# For local development, start the local Supabase stack (`supabase start`) and
# run `supabase status` to print the local URL and keys. For the hosted
# "ProdBnb" project, get these from the Supabase dashboard: Project Settings > API.

# --- Server ---

# Port the Express server listens on.
PORT=4000

# development | test | production
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (the future Web
# client, local dev tools, etc). Leave empty to allow no cross-origin requests.
CORS_ORIGINS=http://localhost:3000

# --- Supabase ---
# SUPABASE_URL and SUPABASE_ANON_KEY are safe to also ship inside client apps
# (iOS/Android/Web) — they only allow what Row Level Security permits.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS entirely. SERVER-ONLY. Never send it
# to a client, never log it, never commit it.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-or-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-or-project-service-role-key

# --- Cloudflare R2 ---
# Actual media (photo/video) storage. Postgres only ever stores metadata/keys,
# never binaries. R2_ACCOUNT_ID/BUCKET_NAME/PUBLIC_BASE_URL are not secret, but
# R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY are SERVER-ONLY — they can mint signed
# URLs for the whole bucket. Never send them to a client, never log them.

R2_ACCOUNT_ID=replace-with-your-cloudflare-account-id
R2_BUCKET_NAME=replace-with-your-bucket-name
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key
# The bucket's public base URL (its r2.dev URL, or a custom domain you've
# connected in the Cloudflare dashboard) — object keys are appended to this.
R2_PUBLIC_BASE_URL=https://replace-with-your-public-bucket-domain

# How long a presigned upload URL stays valid, in seconds.
R2_UPLOAD_URL_EXPIRY_SECONDS=900

# --- Media limits ---
MEDIA_MAX_PHOTO_SIZE_MB=20
MEDIA_MAX_VIDEO_SIZE_MB=500

# --- Server's own public URL (Phase 7) ---
# Used to build the webhook notify_url handed to payment providers. Must be a
# URL Cashfree's servers can actually reach (a local dev instance needs a
# tunnel, e.g. ngrok, for real sandbox webhooks to arrive).
API_BASE_URL=http://localhost:4000

# --- Payments (Phase 7) ---
# Which PaymentProvider implementation is active. Only "cashfree" exists so
# far — see docs/DATABASE.md for how a future Razorpay adapter plugs in here.
PAYMENT_PROVIDER=cashfree

# Cashfree TEST/SANDBOX credentials only — never production. SERVER-ONLY,
# never send to a client, never log, never commit.
CASHFREE_ENV=test
CASHFREE_APP_ID=replace-with-your-cashfree-test-app-id
CASHFREE_SECRET_KEY=replace-with-your-cashfree-test-secret-key
CASHFREE_API_VERSION=2023-08-01

# --- Notifications (Phase 8) ---
# Which NotificationProvider implementation is active: "disabled" (default —
# notifications are still created and stored, push delivery is recorded as
# "skipped") or "apns". The backend is fully testable with NOTIFICATION_PROVIDER
# left at "disabled" and no Apple Developer account at all — see docs/DATABASE.md.
NOTIFICATION_PROVIDER=disabled

# Required only when NOTIFICATION_PROVIDER=apns. APNs TEST/SANDBOX only —
# never production. SERVER-ONLY: never send to a client, never log, never
# commit. APNS_PRIVATE_KEY is the .p8 key's PEM contents on a single line
# with literal \n escapes in place of real newlines.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=replace-with-your-apple-team-id
APNS_KEY_ID=replace-with-your-apns-key-id
APNS_BUNDLE_ID=replace-with-your-ios-bundle-id
APNS_PRIVATE_KEY=replace-with-your-apns-auth-key-pem-single-line
